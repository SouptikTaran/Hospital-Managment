{
  "compilerOptions": {
    "outDir": "./dist",                       // Output directory for JavaScript
    "rootDir": "./src",                       // Input directory
    "target": "es6",                          // ES6 output
    "module": "commonjs",                     // CommonJS module system for Node.js
    "strict": true,                          // Enable strict mode
    "esModuleInterop": true,                 // Allow ESM to CommonJS interop
    "skipLibCheck": true                     // Skip checking TypeScript declarations
  },
  "include": ["src/**/*.ts"],               // Include all TypeScript files
  "exclude": ["node_modules", "**/*.spec.ts"]  // Exclude node_modules and spec files
}
